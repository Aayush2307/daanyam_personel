generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  prosperity   Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cow          Cow?
  actions      DailyAction[]
  payments     RealSevaOrder[]
}

model Cow {
  id         String   @id @default(cuid())
  name       String
  adoptedAt  DateTime @default(now())
  lastFedAt  DateTime?
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyAction {
  id        String   @id @default(cuid())
  type      String
  dateKey   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dateKey])
  @@index([userId, dateKey])
}

model RealSevaOrder {
  id              String   @id @default(cuid())
  planCode        String
  amountInPaise   Int
  currency        String   @default("INR")
  gatewayOrderId  String?
  gatewayProvider String   @default("mock")
  status          String   @default("created")
  createdAt       DateTime @default(now())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
